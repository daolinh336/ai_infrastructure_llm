{
  "name": "infra-react-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Natural-language infrastructure management CLI using a ReAct-style agent",
  "type": "module",
  "bin": {
    "aiagent": "./dist/cli/index.js",
    "infra-react-agent": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:supernova-mcp": "npm --prefix packages/docker-mcp-server-supernova run build",
    "test:chaos": "vitest run tests/three-tier-chaos-pipeline.test.ts",
    "test:pipeline": "npm run test:chaos",
    "demo:metrics": "tsx scripts/run-demo-metrics.ts",
    "eval:planner-prompt": "tsx scripts/run-planner-prompt-eval.ts",
    "metrics:report": "tsx scripts/write-metrics-reports.ts",
    "demo:acceptance": "tsx scripts/run-acceptance-metrics.ts",
    "demo:drift-sync": "tsx scripts/run-drift-sync-metrics.ts",
    "demo:mentor-main": "tsx scripts/run-mentor-main-metrics.ts",
    "demo:main": "tsx scripts/run-mentor-main-metrics.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "openai": "^6.42.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8"
  }
}
