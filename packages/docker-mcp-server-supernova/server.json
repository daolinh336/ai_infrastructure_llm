{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.friendlygeorge/docker-mcp-server",
  "title": "Docker MCP Server",
  "description": "MCP server for Docker — containers, health checks, Compose, logs, monitoring for AI agents",
  "repository": {
    "url": "https://github.com/friendlygeorge/docker-mcp-server",
    "source": "github"
  },
  "version": "0.3.5",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@supernova123/docker-mcp-server",
      "version": "0.3.5",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Docker socket path (default: /var/run/docker.sock)",
          "isRequired": false,
          "format": "string",
          "name": "DOCKER_HOST"
        }
      ]
    }
  ]
}
